{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier — website builder AI professionale, local-first, con compilatore a stadi ed export statico autosufficiente.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "env:vercel": "node scripts/env-vercel.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "3.0.57",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/groq": "4.0.50",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@dnd-kit/core": "6.3.1",
    "@google/genai": "2.24.0",
    "ai": "7.0.116",
    "dexie": "4.4.6",
    "jszip": "3.10.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "linkedom": "^0.18.13",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
